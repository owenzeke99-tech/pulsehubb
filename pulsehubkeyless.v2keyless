local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- // Configuration
local CORRECT_KEY = "PulsehubKeyKalwpwjwbLapoqhwbwkBamwkwuwo"
local KEY_LINK = "https://link4m.net/NgJHo" -- Link Get Key mới
local SAVE_FILE = "PulseHub_KeyData.json"
local KEY_DURATION = 86400 -- 24 giờ tính bằng giây (24 * 60 * 60)

-- // Helper Functions for Hidden Key Persistence (24 Hours)
local function getSavedData()
	if pcall(readfile, SAVE_FILE) then
		local raw = readfile(SAVE_FILE)
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if success and type(decoded) == "table" then
			return decoded
		end
	end
	return nil
end

local function saveKeyData(key)
	local data = {
		Key = key,
		SavedTime = os.time()
	}
	pcall(writefile, SAVE_FILE, HttpService:JSONEncode(data))
end

local function isKeyValid()
	local data = getSavedData()
	if data and data.Key == CORRECT_KEY and data.SavedTime then
		local timePassed = os.time() - data.SavedTime
		if timePassed < KEY_DURATION then
			return true
		end
	end
	return false
end

-- // Auto Bypass Key Check if Saved & Valid (< 24 Hours)
if isKeyValid() then
	loadstring(game:HttpGet("https://raw.githubusercontent.com/PulseZax/Loader/refs/heads/main/.lua"))()
	return
end

