-- // Smooth Shake Animation
local isShaking = false
local function smoothShake()
	if isShaking then return end
	isShaking = true
	
	local basePos = UDim2.new(0.5, 0, 0.5, 0)
	local offsets = {12, -10, 8, -6, 3, 0}
	local duration = 0.04

	for _, offset in ipairs(offsets) do
		local tween = TweenService:Create(
			MainFrame,
			TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{Position = basePos + UDim2.new(0, offset, 0, 0)}
		)
		tween:Play()
		tween.Completed:Wait()
	end
	
	isShaking = false
end

-- // Button Actions
CheckKeyBtn.MouseButton1Click:Connect(function()
	if TextBox.Text == CORRECT_KEY then
		StatusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
		StatusLabel.Text = "Key correct! Loading script..."
		
		TweenService:Create(CardStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(46, 204, 113)}):Play()
		TweenService:Create(NotificationCard, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(15, 35, 28)}):Play()
		
		-- Lưu Key kèm mốc thời gian (Ẩn 24 giờ)
		saveKeyData(CORRECT_KEY)
		
		task.wait(0.6)
		ScreenGui:Destroy()
		
		loadstring(game:HttpGet("https://raw.githubusercontent.com/PulseZax/Loader/refs/heads/main/.lua"))()
	else
		StatusLabel.TextColor3 = Color3.fromRGB(240, 70, 85)
		StatusLabel.Text = "Incorrect key! Please try again."
		TextBox.Text = "" -- Tự động xoá chữ khi nhập sai
		
		TweenService:Create(CardStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(240, 70, 85)}):Play()
		TweenService:Create(BoxStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(240, 70, 85)}):Play()
		TweenService:Create(NotificationCard, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 18, 25)}):Play()
		
		smoothShake()
		
		task.wait(1.5)
		TweenService:Create(CardStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(30, 55, 90)}):Play()
		TweenService:Create(BoxStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(30, 55, 90)}):Play()
		TweenService:Create(NotificationCard, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(17, 24, 38)}):Play()
		StatusLabel.TextColor3 = Color3.fromRGB(160, 180, 205)
		StatusLabel.Text = "Please enter your access key below"
	end
end)

